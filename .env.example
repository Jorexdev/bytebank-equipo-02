# Copia este fichero a .env y cambia los valores. El .env no se sube al repositorio.
POSTGRES_USER=bytebank
POSTGRES_PASSWORD=cambia_esta_clave

# Secreto para firmar los JWT. Mínimo 32 caracteres, aleatorio y distinto en cada entorno.
# Genéralo con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
INTERNAL_KEY=cambia-esta-clave-interna

# Perfil de Spring:
#  - demo: crea usuarios y cuentas de prueba con contraseñas públicas (ver README). Solo para tu equipo.
#  - prod: cualquier entorno con datos reales. Ningún servicio arranca con demo y prod a la vez, y ms-auth
#    no arranca si encuentra usuarios de demo (limpieza: docs/diagnostico.md, sección 4.20).
SPRING_PROFILES_ACTIVE=demo

# Primer gestor de un entorno real. Solo actúa si todavía no hay ningún gestor. Sin valores por defecto:
# la contraseña debe tener entre 12 y 72 caracteres. Quita las dos líneas del .env cuando se haya creado.
# BOOTSTRAP_GESTOR_EMAIL=
# BOOTSTRAP_GESTOR_PASSWORD=
